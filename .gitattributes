# Use LF for the Linux deployment and shared source files.
* text=auto
*.sh text eol=lf
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf
*.py text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
Dockerfile text eol=lf
*.ps1 text eol=crlf
*.pdf binary
*.xlsx binary
*.png binary
