{
  "version": "1.7.0-draft",
  "topics": [
    {
      "topic": "gw/v1/{namespaceId}/{gatewayId}/telemetry",
      "publisher": "gateway",
      "subscriber": "data-service",
      "qos": 1,
      "retain": false,
      "payload": "IngressBatch",
      "acl": "Gateway publishes only own namespace/gateway."
    },
    {
      "topic": "gw/v1/{namespaceId}/{gatewayId}/telemetry-ack",
      "publisher": "data-service",
      "subscriber": "gateway",
      "qos": 1,
      "retain": false,
      "payload": "IngressAck",
      "acl": "Only data-service publishes, gateway subscribes own ACK."
    },
    {
      "topic": "gw/v1/{namespaceId}/{gatewayId}/commands",
      "publisher": "management-service",
      "subscriber": "gateway",
      "qos": 1,
      "retain": false,
      "payload": "Command",
      "acl": "Gateway cannot publish commands; control service restricted to target scope."
    },
    {
      "topic": "gw/v1/{namespaceId}/{gatewayId}/command-results",
      "publisher": "gateway",
      "subscriber": "management-service",
      "qos": 1,
      "retain": false,
      "payload": "TaskResultBatch",
      "acl": "Gateway only own results; management checks task owner."
    },
    {
      "topic": "gw/v1/{namespaceId}/{gatewayId}/result-ack",
      "publisher": "management-service",
      "subscriber": "gateway",
      "qos": 1,
      "retain": false,
      "payload": "TaskResultAck",
      "acl": "Only management publishes; gateway own ACK."
    },
    {
      "topic": "gw/v1/{namespaceId}/{gatewayId}/status",
      "publisher": "gateway",
      "subscriber": "management-service",
      "qos": 1,
      "retain": false,
      "payload": "GatewayStatus",
      "acl": "Own identity only; time freshness separate from transport Last Will."
    },
    {
      "topic": "customer/v1/{targetId}/events",
      "publisher": "data-service",
      "subscriber": "customer-system",
      "qos": 1,
      "retain": false,
      "payload": "CustomerBatch",
      "acl": "Illustrative, freeze actual customer topic per target version."
    },
    {
      "topic": "customer/v1/{targetId}/acks",
      "publisher": "customer-system",
      "subscriber": "data-service",
      "qos": 1,
      "retain": false,
      "payload": "CustomerAck",
      "acl": "Only this target credential publishes; IDs tied to target/version."
    }
  ],
