GW_IMAGE=ble-gateway-server:0.4.0
MOSQUITTO_IMAGE=eclipse-mosquitto:2.0.22
GW_MANAGEMENT_BIND=127.0.0.1
GW_INGRESS_BIND=0.0.0.0
GW_MQTT_BIND=0.0.0.0
# Exact customer server hostnames/IPs authorized for webhook forwarding.
GW_ALLOWED_TARGET_HOSTS=
GW_MAX_QUEUE_BYTES=1073741824
# Total committed AI source file budget, separate from the event pipeline quota.
GW_AI_DOCUMENT_MAX_BYTES=268435456
